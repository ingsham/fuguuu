# Neon PostgreSQL
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# NextAuth - REQUIRED in Vercel Production
NEXTAUTH_SECRET="replace-with-a-long-random-secret"
NEXTAUTH_URL="https://your-fuguaa-domain.vercel.app"
NEXT_PUBLIC_APP_URL="https://your-fuguaa-domain.vercel.app"

# Admin account. The Vercel build seeds/updates this account automatically.
ADMIN_EMAIL="admin@fuguaa.com"
ADMIN_PASSWORD="replace-with-your-own-strong-admin-password"

PAYSTACK_SECRET_KEY="sk_test_xxx"
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY="pk_test_xxx"
BLOB_READ_WRITE_TOKEN=""
RESEND_API_KEY=""
EMAIL_FROM="Fuguaa <noreply@example.com>"
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""
