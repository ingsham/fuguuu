generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  BUYER
  SELLER
  ADMIN
}

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum ProductStatus {
  DRAFT
  ACTIVE
  HIDDEN
  OUT_OF_STOCK
}

enum OrderStatus {
  PENDING
  PAID
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  COMPLETED
  DISPUTED
  REFUNDED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

enum DisputeStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED_REFUND
  RESOLVED_RELEASE
  CLOSED
}

enum DocumentType {
  GHANA_CARD
  PASSPORT
  OTHER
}

model User {
  id            String         @id @default(cuid())
  name          String
  email         String         @unique
  passwordHash  String
  phone         String?
  country       String?
  role          Role           @default(BUYER)
  isActive      Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  sellerProfile SellerProfile?
  buyerOrders   Order[]        @relation("BuyerOrders")
  checkouts     Checkout[]
  reviews       Review[]
  favorites     Favorite[]
  cart          Cart?
  notifications Notification[]
  auditLogs     AuditLog[]
}

model SellerProfile {
  id                 String             @id @default(cuid())
  userId             String             @unique
  shopName           String
  bio                String?
  region             String?
  country            String?
  verificationStatus VerificationStatus  @default(PENDING)
  verifiedAt         DateTime?
  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  verification       SellerVerification?
  products           Product[]
  sellerOrders       Order[]             @relation("SellerOrders")
}

model SellerVerification {
  id                    String             @id @default(cuid())
  sellerId              String             @unique
  documentType          DocumentType
  documentNumberEncrypted String
  documentUrl           String
  status                VerificationStatus @default(PENDING)
  rejectionReason       String?
  submittedAt           DateTime           @default(now())
  reviewedAt            DateTime?
  seller                SellerProfile      @relation(fields: [sellerId], references: [id], onDelete: Cascade)
}

model Product {
  id            String         @id @default(cuid())
  sellerId      String
  title         String
  slug          String         @unique
  description   String?
  price         Decimal        @db.Decimal(12, 2)
  stock         Int            @default(0)
  status        ProductStatus  @default(DRAFT)
  sizes         String[]
  colors        String[]
  fabricType    String?
  occasionTags  String[]
  sizeGuide     String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  seller        SellerProfile  @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  images        ProductImage[]
  orderItems    OrderItem[]
  cartItems     CartItem[]
  favorites     Favorite[]
  reviews       Review[]

  @@index([sellerId, status])
  @@index([status, createdAt])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  url       String
  altText   String?
  sortOrder Int     @default(0)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model Cart {
  id        String     @id @default(cuid())
  buyerId   String     @unique
  updatedAt DateTime   @updatedAt
  buyer     User       @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  items     CartItem[]
}

model CartItem {
  id        String  @id @default(cuid())
  cartId    String
  productId String
  quantity  Int     @default(1)
  size      String?
  color     String?
  cart      Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([cartId, productId, size, color])
}

model Favorite {
  id        String   @id @default(cuid())
  buyerId   String
  productId String
  createdAt DateTime @default(now())
  buyer     User     @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([buyerId, productId])
}

model Checkout {
  id        String    @id @default(cuid())
  reference String    @unique
  buyerId   String
  total     Decimal   @db.Decimal(12, 2)
  currency  String    @default("GHS")
  createdAt DateTime  @default(now())
  buyer     User      @relation(fields: [buyerId], references: [id], onDelete: Restrict)
  orders    Order[]
  payment   Payment?
}

model Order {
  id                String        @id @default(cuid())
  orderNumber       String        @unique
  checkoutId        String?
  buyerId           String
  sellerId          String
  status            OrderStatus   @default(PENDING)
  paymentStatus     PaymentStatus @default(PENDING)
  escrowStatus      String        @default("HELD")
  total             Decimal       @db.Decimal(12, 2)
  currency          String        @default("GHS")
  paystackReference String?
  deliveredAt       DateTime?
  completedAt       DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  checkout          Checkout?     @relation(fields: [checkoutId], references: [id], onDelete: SetNull)
  buyer             User          @relation("BuyerOrders", fields: [buyerId], references: [id], onDelete: Restrict)
  seller            SellerProfile @relation("SellerOrders", fields: [sellerId], references: [id], onDelete: Restrict)
  items             OrderItem[]
  payment           Payment?
  dispute           Dispute?
  reviews           Review[]

  @@index([buyerId, createdAt])
  @@index([sellerId, createdAt])
  @@index([status])
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  productId String
  quantity  Int
  price     Decimal @db.Decimal(12, 2)
  size      String?
  color     String?
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)
}

model Payment {
  id         String        @id @default(cuid())
  orderId    String?       @unique
  checkoutId String?       @unique
  reference  String        @unique
  amount     Decimal       @db.Decimal(12, 2)
  currency   String        @default("GHS")
  status     PaymentStatus @default(PENDING)
  gateway    String        @default("PAYSTACK")
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  checkout   Checkout?     @relation(fields: [checkoutId], references: [id], onDelete: Cascade)
  order      Order?        @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model Review {
  id        String   @id @default(cuid())
  orderId   String
  productId String
  buyerId   String
  rating    Int
  comment   String?
  photos    String[]
  createdAt DateTime @default(now())
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Restrict)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  buyer     User     @relation(fields: [buyerId], references: [id], onDelete: Restrict)

  @@unique([orderId, productId, buyerId])
}

model Dispute {
  id             String        @id @default(cuid())
  orderId        String        @unique
  reason         String
  status         DisputeStatus @default(OPEN)
  resolutionNote String?
  resolvedById   String?
  createdAt      DateTime      @default(now())
  resolvedAt     DateTime?
  order          Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String
  channel   String
  subject   String?
  message   String
  status    String   @default("PENDING")
  createdAt DateTime @default(now())
  sentAt    DateTime?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  adminId    String
  action     String
  targetType String
  targetId   String
  metadata   Json?
  createdAt  DateTime @default(now())
  admin      User     @relation(fields: [adminId], references: [id], onDelete: Restrict)

  @@index([createdAt])
  @@index([targetType, targetId])
}
